SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SEDERUNT_SESSION_SECRET=
# SEDERUNT_AUTH_FAKE=1
# Fake consent only. Overrides the scope string on a Forms grant. Empty uses the requested scopes.
# SEDERUNT_AUTH_FAKE_SCOPE=
# 32-byte AES key, base64. Server only. Never put a real key in git.
MCP_SECRETS_KEY_V1=
# SUPABASE_SECRET_KEY=sb_secret_xxx
# SEDERUNT_MCP_FAKE=1
# SEDERUNT_MCP_FAKE_PORT=
# SEDERUNT_FORMS_FAKE=1
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Ask AI (web). Placeholders only — set real values in Vercel / your shell.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional comma-separated fallbacks after OPENROUTER_MODEL. Default when unset:
# openai/gpt-oss-120b,openai/gpt-oss-20b
# OPENROUTER_MODEL_FALLBACKS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Local/dev: Upstash REST (wins when set). Prod: Vercel Marketplace Redis via REDIS_URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
ASK_PROMPT_LIMIT=5
ASK_QUOTA_TIMEZONE=Asia/Saigon
ASK_REDIS_PREFIX=sederunt:ask
ASK_TTL_SECONDS=604800

# Optional administration, server-only. Store a scrypt hash, never a plaintext password.
# SEDERUNT_ADMIN_USERNAME=
# SEDERUNT_ADMIN_PASSWORD_HASH=
# SEDERUNT_ADMIN_SESSION_SECRET=
# Public deployment origin, used for OAuth callbacks.
# SEDERUNT_PUBLIC_ORIGIN=http://127.0.0.1:8787
